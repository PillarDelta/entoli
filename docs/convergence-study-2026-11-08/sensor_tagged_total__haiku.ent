effect Sensor prompt { read : Str -> Int @idempotent }

def gather : Unit -[Sensor]-> Int =
  fn u ->
    let n = do Sensor.read("north") in
    let s = do Sensor.read("south") in
    let e = do Sensor.read("east") in
    n + s + e

def calibrated : Cap[Sensor] -[]-> Data =
  fn cap ->
    handle gather(()) with Sensor {
      read(x; k) -> if x == "north" then resume k 10 else resume k 20
      return r -> Reading(r + 1, 1)
    } using cap