effect Pricing prompt { quote : Str -> Int @idempotent }
effect Ledger suspending { post : Data -> Data @at_least_once }

def basket : Unit -[Pricing]-> Int =
  fn u ->
    let a = do Pricing.quote("apple") in
    let b = do Pricing.quote("bread") in
    a + b

def priced : Cap[Pricing] -[]-> Int =
  fn cap ->
    handle basket(()) with Pricing {
      quote(x; k) -> resume k (if x == "apple" then 3 else 5)
      return r -> r
    } using cap

def checkout : Cap[Pricing] -[Ledger]-> Data =
  fn cap ->
    let n = priced(cap) in
    let p = do Ledger.post(Total(n)) witness concat("basket:", str_of_int(n)) in
    Recorded(p)